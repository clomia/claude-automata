{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anchor-hook anchor-pre-tool-use",
            "timeout": 30,
            "statusMessage": "anchor: gating"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "anchor:anchor",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anchor-hook anchor-subagent-stop",
            "timeout": 120,
            "statusMessage": "anchor: advising"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anchor-hook anchor-update-check"
          }
        ]
      }
    ]
  }
}
