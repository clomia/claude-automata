#!/usr/bin/env sh
# version-up-alert-hook — run the update check with no virtualenv.
#
# The plugin is stdlib-only, so the entry runs straight off the source Claude
# Code copied into ${CLAUDE_PLUGIN_ROOT}; a venv must never be written there
# (that cache is ephemeral, shared across every project on the machine, and
# rebuilt on every version bump). Installed as a dependency of every plugin,
# this is the one place the marketplace surfaces its uv prerequisite: a single
# systemMessage when uv cannot run, then exit 0 — a missing prerequisite never
# breaks a session.

set -e

[ -n "$1" ] || exit 0

if ! command -v uv >/dev/null 2>&1; then
    printf '%s' '{"systemMessage":"claude-automata plugins require uv (Python package manager). Install it from https://docs.astral.sh/uv/getting-started/installation/ — without uv, no plugin hooks can run."}'
    exit 0
fi

if ! uv python find ">=3.14" >/dev/null 2>&1 && ! uv python install 3.14 >/dev/null 2>&1; then
    printf '%s' '{"systemMessage":"uv cannot provision Python >= 3.14 (needs a download or network) — claude-automata hooks are off this session."}'
    exit 0
fi

export PYTHONPATH="${CLAUDE_PLUGIN_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec uv run --no-project --python ">=3.14" python -m src "$@"
