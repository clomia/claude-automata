{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/version-up-alert-hook",
            "args": ["update-check"],
            "timeout": 30,
            "statusMessage": "version-up-alert: checking plugin versions"
          }
        ]
      }
    ]
  }
}
