{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "ploop:launch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["launch"]
          }
        ]
      },
      {
        "matcher": "ploop:off",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["off-command"]
          }
        ]
      },
      {
        "matcher": "ploop:on",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["on-command"]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["mark-compaction"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["pre-tool-use"],
            "timeout": 30,
            "statusMessage": "ploop: gating"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["stop"],
            "timeout": 120,
            "statusMessage": "ploop: advising"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["subagent-stop"]
          }
        ]
      }
    ]
  }
}
