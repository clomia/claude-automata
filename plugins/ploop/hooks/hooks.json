{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^ploop:launch$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["launch"],
            "statusMessage": "ploop: launching loop"
          }
        ]
      },
      {
        "matcher": "^ploop:off$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["off-command"],
            "statusMessage": "ploop: pausing loop"
          }
        ]
      },
      {
        "matcher": "^ploop:on$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["on-command"],
            "statusMessage": "ploop: resuming loop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["reanchor"],
            "statusMessage": "ploop: re-anchoring"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["pre-tool-use"],
            "timeout": 30,
            "statusMessage": "ploop: advisor gate"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["guard"],
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["guard"],
            "timeout": 30
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["guard"],
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["guard"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["stop"],
            "timeout": 120,
            "statusMessage": "ploop: loop check"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["heartbeat"],
            "asyncRewake": true,
            "timeout": 11100,
            "statusMessage": "ploop: heartbeat"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/ploop-hook",
            "args": ["subagent-stop"],
            "statusMessage": "ploop: subagent check"
          }
        ]
      }
    ]
  }
}
