{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/parallax-loop-hook parallax-loop-user-prompt-submit"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/parallax-loop-hook parallax-loop-mark-compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/parallax-loop-hook parallax-loop-pre-tool-use",
            "timeout": 30,
            "statusMessage": "parallax-loop: gating"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/parallax-loop-hook parallax-loop-stop",
            "timeout": 120,
            "statusMessage": "parallax-loop: advising"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/parallax-loop-hook parallax-loop-update-check"
          }
        ]
      }
    ]
  }
}
