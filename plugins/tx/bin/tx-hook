#!/usr/bin/env sh
# tx-hook — run a bundled entry point with no virtualenv.
#
# The plugin is stdlib-only, so the entry runs straight off the source Claude
# Code copied into ${CLAUDE_PLUGIN_ROOT}; a venv must never be written there
# (that cache is ephemeral, shared across every project on the machine, and
# rebuilt on every version bump). Every tx hook and skill routes through here.
# git-sync-off/on block when uv cannot run so their skill bodies never announce
# a toggle that didn't happen; every other entry stays silent — the session-start
# uv notice is version-up-alert's job.

set -e

entry="$1"

[ -n "$entry" ] || exit 0

if ! command -v uv >/dev/null 2>&1 ||
    { ! uv python find ">=3.14" >/dev/null 2>&1 && ! uv python install 3.14 >/dev/null 2>&1; }; then
    case "$entry" in
        git-sync-off | git-sync-on)
            printf '%s' '{"decision":"block","reason":"uv cannot run the plugin — the toggle did not happen."}'
            ;;
    esac
    exit 0
fi

export PYTHONPATH="${CLAUDE_PLUGIN_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec uv run --no-project --python ">=3.14" python -m src "$@"
