{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/tx-hook branch-state-warn",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/tx-hook branch-protect-block",
            "statusMessage": "tx: guarding branch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/tx-hook git-sync",
            "timeout": 60,
            "statusMessage": "tx: sync check"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "tx:git-sync-off",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/tx-hook git-sync-off"
          }
        ]
      },
      {
        "matcher": "tx:git-sync-on",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/tx-hook git-sync-on"
          }
        ]
      }
    ]
  }
}
